<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="@raw/vulnbank_lab_ca" />
        </trust-anchors>
    </base-config>
    <!-- TLS anchors below are legacy HTTPS-demo only. HTTP through Burp needs no CA. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
